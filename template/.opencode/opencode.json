{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "permissions": [
    {
      "action": "shell",
      "resource": "rojo build *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rojo sourcemap *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "luau-lsp analyze *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "selene *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "stylua --check *",
      "effect": "allow"
    }
  ]
}
